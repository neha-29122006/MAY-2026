from math import factorial

class Solution:
    def getPermutation(self, n: int, k: int) -> str:
        nums = [str(i) for i in range(1, n + 1)]
        k -= 1  # convert to 0-based index

        ans = []

        for i in range(n, 0, -1):
            block_size = factorial(i - 1)

            idx = k // block_size
            ans.append(nums.pop(idx))

            k %= block_size

        return "".join(ans)
