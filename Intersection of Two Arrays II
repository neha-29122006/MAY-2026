class Solution:
    def intersect(self, nums1: list[int], nums2: list[int]) -> list[int]:

        if len(nums1) > len(nums2):
            nums1, nums2 = nums2, nums1

        frequency = {}

        for num in nums1:
            frequency[num] = frequency.get(num, 0) + 1

        intersection = []

        for num in nums2:
            if frequency.get(num, 0) > 0:
                intersection.append(num)
                frequency[num] -= 1

        return intersection
