import random
from typing import List

class Solution:

    def __init__(self, m: int, n: int):
        self.rows = m
        self.cols = n
        self.total = m * n
        self.remaining = self.total
        self.mapping = {}

    def flip(self) -> List[int]:
        r = random.randint(0, self.remaining - 1)

        idx = self.mapping.get(r, r)

        self.remaining -= 1

        self.mapping[r] = self.mapping.get(
            self.remaining,
            self.remaining
        )

        return [idx // self.cols, idx % self.cols]

    def reset(self) -> None:
        self.mapping.clear()
        self.remaining = self.total
