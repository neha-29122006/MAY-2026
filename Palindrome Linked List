class Solution:
    def isPalindrome(self, head: Optional[ListNode]) -> bool:
        slow = head
        fast = head
        prev = None

        while fast and fast.next:
            fast = fast.next.next
            nxt = slow.next
            slow.next = prev
            prev = slow
            slow = nxt

        if fast:
            slow = slow.next

        while slow:
            if prev.val != slow.val:
                return False
            prev = prev.next
            slow = slow.next

        return True
