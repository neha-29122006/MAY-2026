from collections import defaultdict
from bisect import bisect_left, bisect_right

class MajorityChecker:

    def __init__(self, arr: list[int]):
        self.arr = arr
        self.positions = defaultdict(list)

        for index, value in enumerate(arr):
            self.positions[value].append(index)

    def query(self, left: int, right: int, threshold: int) -> int:

        candidate = None
        count = 0

        for i in range(left, right + 1):

            if count == 0:
                candidate = self.arr[i]
                count = 1
            elif self.arr[i] == candidate:
                count += 1
            else:
                count -= 1

        indexes = self.positions[candidate]

        occurrences = bisect_right(indexes, right) - bisect_left(indexes, left)

        return candidate if occurrences >= threshold else -1
